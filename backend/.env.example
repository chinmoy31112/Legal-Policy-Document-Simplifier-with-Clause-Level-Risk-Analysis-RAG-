# =============================================================================
# Application Settings
# =============================================================================
APP_NAME="Legal Document Simplifier"
APP_VERSION="1.0.0"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# Server
# =============================================================================
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://your_username:your_password@localhost:5432/legal_simplifier
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# Authentication
# =============================================================================
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Google AI Models & Rate Limits (Models as Config)
# =============================================================================
GOOGLE_API_KEY=your-google-api-key-here
# Model selection:
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_CLAUSE_MODEL=gemini-3.5-flash-lite
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
GEMINI_ESCALATION_MODEL=
GEMINI_ENABLE_ESCALATION=false
GEMINI_ANALYSIS_BATCH_SIZE=4
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_OUTPUT_TOKENS=8192

# Gemini 3.5 Flash-Lite limits (throttled below 15 RPM / 250k TPM / 500 RPD free tier):
GEMINI_FLASH_LITE_RPM=12
GEMINI_FLASH_LITE_TPM=250000
GEMINI_FLASH_LITE_RPD=400

# Gemini 3.8 Flash limits (throttled below 5 RPM / 250k TPM / 20 RPD free tier):
GEMINI_FLASH_RPM=4
GEMINI_FLASH_TPM=250000
GEMINI_FLASH_RPD=16

# Gemini Embedding limits (throttled below 100 RPM free tier):
GEMINI_EMBEDDING_RPM=80
GEMINI_EMBEDDING_TPM=80000
GEMINI_EMBEDDING_RPD=1000

# =============================================================================
# ChromaDB (Embedded Mode)
# =============================================================================
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=legal_clauses

# =============================================================================
# File Upload
# =============================================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.docx,.txt,.md,.json

# =============================================================================
# RAG Configuration
# =============================================================================
RETRIEVAL_TOP_K=5
EMBEDDING_BATCH_SIZE=50

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
