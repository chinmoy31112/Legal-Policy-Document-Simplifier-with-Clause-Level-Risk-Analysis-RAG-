# =============================================================================
# Legal Document Simplifier — Production Environment Configuration (.env)
# =============================================================================

# Application Metadata
APP_NAME="Legal Document Simplifier"
APP_VERSION="1.0.0"
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Server & Network
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database (with pgvector)
POSTGRES_DB=legal_simplifier
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_replace_in_production
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password_replace_in_production@postgres:5432/legal_simplifier
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (ARQ Background Worker)
REDIS_URL=redis://redis:6379/0

# JWT Authentication
JWT_SECRET_KEY=generate-a-strong-random-64-char-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini API
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=8192

# Storage & Upload Limits
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.docx,.txt,.md,.json

# RAG & Grounding Parameters
RETRIEVAL_TOP_K=5
EMBEDDING_BATCH_SIZE=50
RATE_LIMIT_PER_MINUTE=60

# Frontend Next.js API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
